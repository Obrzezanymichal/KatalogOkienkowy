<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="KatalogOkienkowy" Height="600" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Katalog produktow"
                   FontSize="24" 
                   FontWeight="Bold" />
        <TextBlock x:Name="EtykietaLiczby" 
                   Text="Produktów: 0"
                   FontSize="14"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="EtykietaWartoscMagazynu"
                   Text="Wartość magazynu: 0"
                   FontSize="14"
                   Margin="0,10,0,0" />
        <Button HorizontalAlignment="Center" Padding="5">
            <Image Source="/Images/plus.png" Width="16" Height="16" Margin="0,0,5,0" />
            <TextBlock Text="Dodaj produkt"
                       FontSize="16"
                       FontWeight="Bold" />
    </StackPanel>
    </Button>
    
    
   <Grid>
        <Grid.RowDefinition>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinition>

        </Grid>
    </Button>
</Window>
